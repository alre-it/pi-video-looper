# Installed as /etc/systemd/system/mnt-videos.mount. The unit name must match
# the mount point (/mnt/videos). Credentials live in /etc/smbcredentials
# (username=, password=, domain=; mode 600).
[Unit]
Description=SMB share with the media to loop
After=network-online.target
Wants=network-online.target

[Mount]
What=@SHARE@
Where=/mnt/videos
Type=cifs
Options=credentials=/etc/smbcredentials,vers=3.1.1,sec=ntlmssp,noserverino,iocharset=utf8,soft,ro
TimeoutSec=30

[Install]
WantedBy=multi-user.target
