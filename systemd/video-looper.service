[Unit]
Description=Video Loop Player
After=multi-user.target sync-media.service
PartOf=work-hours.target

[Service]
User=tv
WorkingDirectory=/var/lib/pi-video-looper/media

# AUDIO / AUDIO_DEVICE come from /etc/default/pi-video-looper.
EnvironmentFile=-/etc/default/pi-video-looper
# Seconds each still image stays on screen. sync-media.sh writes the value
# from the upload server's settings into image_display_duration_sec.txt.
Environment=IMAGE_DISPLAY_DURATION=240
EnvironmentFile=-/var/lib/pi-video-looper/media/image_display_duration_sec.txt

# A logind session on tty1 gives mpv access to the DRM device.
PAMName=login
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

ExecStartPre=+/usr/bin/chvt 1
# MEDIA_DIR from /etc/default/pi-video-looper (the USB mount with usb-direct);
# build-playlist.sh falls back to /var/lib/pi-video-looper/media when it is empty.
ExecStartPre=+/usr/local/bin/build-playlist.sh "${MEDIA_DIR}" /run/playlist.m3u
ExecStart=/usr/local/bin/play-loop.sh /run/playlist.m3u

Restart=always
RestartSec=5

[Install]
WantedBy=work-hours.target
