[Unit]
Description=Video Loop Player
After=multi-user.target sync-media.service
PartOf=work-hours.target

[Service]
User=tv
WorkingDirectory=/var/lib/pi-video-looper/media

# Seconds each still image stays on screen. sync-media.sh writes the value
# from the upload server's settings into image_display_duration_sec.txt.
Environment=IMAGE_DISPLAY_DURATION=240
EnvironmentFile=-/var/lib/pi-video-looper/media/image_display_duration_sec.txt

# A logind session on tty1 gives mpv access to the DRM device.
PAMName=login
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

ExecStartPre=+/usr/bin/chvt 1
ExecStartPre=+/usr/local/bin/build-playlist.sh /var/lib/pi-video-looper/media /run/playlist.m3u
ExecStart=/usr/bin/mpv \
      --no-resume-playback --playlist-start=0 --start=0 \
      --no-audio --fs --loop-playlist=inf --no-osd-bar \
      --image-display-duration=${IMAGE_DISPLAY_DURATION} \
      --no-terminal \
      --gpu-context=drm --drm-mode=preferred \
      --hwdec=auto-safe \
      /run/playlist.m3u

Restart=always
RestartSec=5

[Install]
WantedBy=work-hours.target
